#
# PROBLEM: a media definition has TWO name spaces and one sigil.
# The block's LABEL names the installed library file; `@`
# references an ITEM inside it. They can differ — and for archive
# definitions they usually do.

description "Media labels are not item names"
platform    dos
machine     stopped
timeout     2m

media freedos-livecd {
  "url": "https://download.freedos.org/1.4/FD14-LiveCD.zip",
  "sha256": "2020ff6bb681967fd6eff8f51ad2e5cd5ab4421165948cef4246e4f7fcaf6339",
  "items": [
    {
      "name": "freedos-1.4-livecd",
      "file": "FD14LIVE.iso",
      "sha256": "c48a9dcf4b8e22f44e268a9879745f0bd88c061195ac584e6ef2deb0477f81fb"
    }
  ]
}
# label:  freedos-livecd      -> installs media/freedos-livecd.json
# item:   freedos-1.4-livecd  -> what @ can actually reference

property media supplemental-disk prompt="Supplemental disk"

insert cdrom0 @freedos-1.4-livecd   # the ITEM name — correct
# insert cdrom0 @freedos-livecd     # the LABEL — WRONG: resolves
                                    # only if some item happens to
                                    # share the label's spelling.
                                    # The definition site sits ten
                                    # lines up and still misleads.
start
wait "Welcome to FreeDOS 1.4 (LiveCD)"

# A second, related mush: the same argument slot accepts two sigils
# with different definiteness —
#
#     insert cdrom0  @freedos-1.4-livecd    exactly this catalog item
#     insert floppy1 $supplemental-disk     whichever item the run
#                                           supplies (an explicit
#                                           value, parameter,
#                                           property, or ask)
#
# @ promises a specific item; $ defers the choice to run time. Both
# look equally definite on the page, and both resolve to "a media
# item" — the reader must recall the property declaration to know
# one insert is fixed and the other is a variable.
#
# OPEN QUESTIONS: should a single-item definition default its
# label to its item name (removing the gap in the common case)?
# Should validation warn when a label is @-referenced and no item
# shares its spelling (the near-miss above)? The $-definiteness
# point is likely inherent — properties exist to defer choices —
# but a transcript line naming the resolved item at insert time
# would close the observability half of it.
