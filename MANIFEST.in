include src/reliquary/codex/codex.json
include src/reliquary/codex/blueprints/*.rlqb
include src/reliquary/codex/scripts/*.rlqs

# Documentation ships with the source package, as it conventionally
# does. `planning/` does not: it is maintainer governance, and the
# `planning/design` graft that used to sit here existed only so the
# suite could parse the script-example catalogue out of an unpacked
# sdist — which nothing does now that the suite is not shipped.
graft docs

# The suite ships in NEITHER artifact (D96): it is developed and run
# from the repository, which is the only place it is complete.
# Package discovery is confined to src/ for the wheel; setuptools'
# sdist file discovery recognizes a root tests/ directory, so prune
# it explicitly there.
prune tests
global-exclude __pycache__/* *.py[co]
