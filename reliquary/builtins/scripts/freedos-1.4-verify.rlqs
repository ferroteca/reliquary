description "Boot the installed FreeDOS disk and confirm a DOS prompt"
platform dos
machine  stopped
timeout  2m

# After the install script's final eject, the machine is back in its
# blueprint shape: boot is hdd then cdrom, so a plain start boots the
# installed hard disk (an empty CD is never tried).
start
wait "C:\>"
screenshot verified
enter "fdapm poweroff"
wait machine=stopped
