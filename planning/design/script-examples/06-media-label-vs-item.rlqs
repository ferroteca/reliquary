#
# RESOLVED (owner, 2026-07-22 — planning/DECISIONS.md, no JSON in
# scripts). Kept as a regression note.
#
# THE PROBLEM WAS: a media definition embedded in a script had TWO
# name spaces and one sigil. The block's LABEL named the installed
# library file; `@` referenced an ITEM inside it. They could
# differ — and for archive definitions they usually did:
#
#     media freedos-livecd {            <- label: names the file
#       "url": "...FD14-LiveCD.zip",       installed as
#       "items": [                         freedos-livecd.rlqm
#         { "name": "freedos-livecd",  <- item: what @ takes
#           "file": "FD14LIVE.iso" } ]
#     }
#
#     insert cdrom0 @freedos-livecd   # the ITEM — correct
#     insert cdrom0 @freedos-livecd       # the LABEL — WRONG
#
# THE RESOLUTION: embedded media blocks are deleted outright, so
# the label is gone with them. A definition is an authored `.rlqm`
# file whose stem is its own name and carries no item meaning; `@`
# names an item, and there is no second spelling to confuse it
# with. The remaining half — rejecting an `@`-reference that
# matches no known item — was implemented 2026-07-27, in the
# preflight beside the slot check that guards the same statement's
# other argument. It was never a language change: script-spec.md's
# preflight list had always required it.
#
# (The rest of this file's framing is stale — it describes media as
# authored `.rlqm` files, which retired with milestone 7 — and is
# queued for the same pass that decides what the file is now for.)

description "Media references name items, not files"
platform    dos
machine     stopped
timeout     2m

property media supplemental-disk prompt="Supplemental disk"

insert cdrom0 @freedos-livecd   # an item in the shared catalog,
                                    # defined by a .rlqm file beside
                                    # this script or in the home
start
wait "Welcome to FreeDOS 1.4 (LiveCD)"

# THE SURVIVING MUSH: the same argument slot accepts two sigils
# with different definiteness —
#
#     insert cdrom0  @freedos-livecd    exactly this catalog item
#     insert floppy1 $supplemental-disk     whichever item the run
#                                           supplies (an explicit
#                                           value, parameter,
#                                           property, or ask)
#
# @ promises a specific item; $ defers the choice to run time. Both
# look equally definite on the page, and both resolve to "a media
# item" — the reader must recall the property declaration to know
# one insert is fixed and the other is a variable.
#
# OPEN QUESTION: the $-definiteness point is likely inherent —
# properties exist to defer choices — but a transcript line naming
# the resolved item at insert time would close the observability
# half of it.
