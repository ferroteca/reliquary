#
# RESOLVED (July 2026, milestone zero) — kept as a regression note.
#
# The problem was: `on` had one syntax and two lifecycles, chosen
# entirely by its container — a one-shot branch inside a branching
# wait, a persistent re-arming watcher directly inside a reactive
# phase. Identical lines, different meanings; the form alone could
# not tell you its lifetime.
#
# THE FIX: the lifetime is in the first word. `on` arms a one-shot
# branch and is legal only inside a branching wait; `always` arms
# a standing rule and is legal only directly inside a reactive
# phase. Same shape, same condition spellings; a container
# mismatch is a validation error. (Prior art: Tcl splits expect
# vs expect_background by name, not by shape.)

description "One handler shape, two named lifetimes"
platform    dos
entry       one-shot
timeout     30s

phase one-shot {
    enter "setup"
    wait {
        on "Format now?"  { select "Yes" }
        on "Skip format?" { select "No"  }
    }
    screenshot after-format
    goto persistent
}

phase persistent timeout=5m deadline=30m {
    always "Insert disk 2"  { press enter }
    always "Setup complete" { finish }
}

# RESIDUE (accepted): the two control-flow subtleties survive as
# documented behavior — invisible fall-through (execution continues
# after a branching wait whose matched body did not transition) and
# hidden terminals (a sequential phase may end in a branching wait
# whose every body terminates, so the terminal is nested, not at
# the phase's bottom edge). Both are checked per body by the
# terminating-statements rules.
