// A complete worked example: one blueprint holding the machine and
// every media it draws on, in the composed format.
[
  {
    "type": "machine",
    "name": "freedos",
    "platform": "dos",
    "memory": "32M",
    "description": "FreeDOS 1.4 plain install from the LiveCD",
    "drives": {
      // A blank hard disk written in place. It has no name because
      // nothing refers to it — the sole anonymous citizen of the
      // format, named for its slot when it is materialized.
      "hdd0": { "type": "media", "size": "20M" },
      // An empty removable slot the install script fills.
      "cdrom0": null
    },
    "boot": ["hdd0", "cdrom0"]
  },

  {
    // The container and its child. One remote rung carries the hash;
    // the child is reached by its path inside, and is a media like any
    // other — the archive/media distinction was never a property of
    // the artifact, only of the use.
    "type": "media",
    "name": "freedos-livecd-zip",
    "location": "https://download.freedos.org/1.4/FD14-LiveCD.zip",
    "sha256": "2020ff6bb681967fd6eff8f51ad2e5cd5ab4421165948cef4246e4f7fcaf6339",
    "children": [
      {
        "type": "media",
        "path": "FD14LIVE.iso",
        "name": "freedos-livecd",
        "read-only": true,
        "sha256": "c48a9dcf4b8e22f44e268a9879745f0bd88c061195ac584e6ef2deb0477f81fb"
      }
    ]
  }
]
