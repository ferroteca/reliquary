description "Ask the guest for its live VGA font and write it to FONT.BIN"
platform    dos
machine     stopped
timeout     2m

# The guest is the only party that knows which font it loaded (U25,
# D109). `INT 10h AH=11h AL=30h` with `BH=03h` returns a pointer
# (ES:BP) to the live 8x16 character table the guest installed — not
# a fixed ROM address — all 256 glyphs, 4096 bytes. DEBUG is present
# on every codex FreeDOS install (`C:\FREEDOS\BIN`, on PATH), so the
# call is made by typing a stub at its prompt rather than staging a
# program (P2, P3): the stub runs once and goes with the machine.
#
# This script writes to D:\FONT.BIN — undeclared on the codex
# blueprint (P16, D108): a host directory is the author's own path,
# so give the machine a `share` before running this
# (docs/dos-automation.md). No insert or eject appears here, because
# a share carries no image for a live swap to match sizes against
# (`machines._medium_size`), so attaching it is the blueprint's job,
# done once, before start.
#
# D: (F68): a share renders disk-shaped, not floppy-shaped (unlike
# the directory-on-floppy0 mechanism this replaced, which DOS always
# lettered A: regardless of what else was attached). Confirmed
# against a real boot of the codex freedos blueprint (hdd0, cdrom0)
# plus one added share: DOS assigns fixed-disk letters to every
# BIOS-visible non-removable drive before the CD-ROM redirector
# claims its own — hdd0 is C:, the share is D:, and only then does
# FDAUTO.BAT's CD-ROM driver take the next free letter, E:. This
# holds for this exact shape (one hdd, one cdrom, one share); a
# blueprint with more drives before the share shifts the letter down
# accordingly, the same way adding a second physical hard disk would.
start
wait "C:\>"
enter "DEBUG"
wait /^-$/
enter "A 100"
enter "mov ah,11"
enter "mov al,30"
enter "mov bh,3"
enter "int 10"
# ES:BP now points at the live table. Copying it down to a fixed
# offset in this program's own segment (CS:0300, well past the stub)
# means the write below never has to know that segment's number —
# DEBUG's `W` always writes relative to CS unless told otherwise.
enter "mov si,bp"
enter "mov ax,es"
enter "mov ds,ax"
enter "mov ax,cs"
enter "mov es,ax"
enter "mov di,300"
enter "mov cx,1000"
enter "cld"
enter "rep movsb"
enter "int 3"
enter ""
wait /^-$/
enter "G=100"
wait "Unexpected breakpoint interrupt"
# BX:CX is the byte count DEBUG's `W` writes when the target file is
# new — 0000:1000 (4096) — set explicitly rather than trusted from
# whatever the registers already held.
enter "N D:\FONT.BIN"
enter "R BX"
enter "0"
enter "R CX"
enter "1000"
enter "W 300"
wait "Writing 1000 bytes"
enter "Q"
wait "C:\>"
enter "fdapm poweroff"
wait machine=stopped timeout=2m
