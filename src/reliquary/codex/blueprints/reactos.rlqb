// ReactOS, installed from its own install ISO. Its second-stage
// setup is a real graphical (GUI) wizard with Next/Back buttons,
// unlike FreeDOS's text-only installer — that's what makes it a
// good test of click/pointer input (F66).
//
// Codex entries are named for the system, not the version. The
// version lives below in the media's location and hash, so a
// version bump only touches those two lines.
[
  {
    "type": "machine",
    "name": "reactos",
    "platform": "winnt",
    "memory": "512M",
    "pointing-device": "tablet",
    "control-planes": ["vnc"],
    "description": "ReactOS 0.4.15-x86 installed from its own ISO",
    "devices": {
      // Blank disk. The installer partitions and formats it.
      "hdd0": { "type": "media", "size": "2G" },
      // Empty for now. The install script inserts the ISO here.
      "cdrom0": null
    },
    // Boot from the hard disk first, always — even though it starts
    // blank. A blank disk has no boot signature, so on the very
    // first boot the firmware skips it and boots the CD instead.
    // Later, once setup has copied files and reboots, the disk IS
    // bootable, and this order sends the guest straight into it —
    // which is what we want, since that's when the graphical setup
    // stage runs.
    //
    // We tried cdrom-first instead and it broke: on the reboot, the
    // CD boots again and restarts Setup, which then finds the
    // half-installed disk and stops at an "upgrade or repair?"
    // screen instead of continuing (measured 2026-08-26). ReactOS's
    // installer is supposed to detect an in-progress install and
    // resume it automatically, but that didn't happen reliably here.
    //
    // We also can't use freedos.rlqb's trick of temporarily
    // rewriting the boot order for one run (`with boot`), because
    // this install script leaves the machine running when it's
    // done, and reliquary refuses to change the boot order of a
    // running machine (D104).
    "boot": ["hdd0", "cdrom0"],
    "scripts": {
      "install": "reactos-install"
    }
  },

  {
    // This downloads a .zip from SourceForge, and the ISO we
    // actually want is a file inside it (named below by its path in
    // the zip). SourceForge's "download" link redirects to the real
    // file over plain HTTP with no JavaScript involved, so nothing
    // special is needed to fetch it. We do need `extension: "zip"`
    // below, though: the URL's path ends in "/download", not
    // ".zip", so reliquary can't guess the file type from the URL
    // alone.
    "type": "media",
    "name": "reactos-iso-zip",
    "location": "https://sourceforge.net/projects/reactos/files/ReactOS/0.4.15/ReactOS-0.4.15-x86-iso.zip/download",
    "extension": "zip",
    "sha256": "db9f80e7eabecabfe0b2ff890502d8d67b8d4aed0fc967ef957dee3c9e5e0682",
    "children": [
      {
        "type": "media",
        "path": "ReactOS-0.4.15-x86.iso",
        "name": "reactos-iso",
        "description": "The ReactOS 0.4.15-x86 install ISO",
        "read-only": true,
        "sha256": "206a4746c37e792dda5996a449d820eb36f5771b399f498185af81d89718f785"
      }
    ]
  }
]
