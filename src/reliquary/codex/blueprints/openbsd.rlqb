// OpenBSD, installed unattended with autoinstall over Reliquary's
// run-scoped HTTP server.
//
// Named for the system, not the release: the version lives below as the
// location and its hash.
[
  {
    "type": "machine",
    "name": "openbsd",
    "platform": "openbsd",
    "memory": "512M",
    "description": "OpenBSD 7.9 amd64 installed from install79.iso using autoinstall over reliquary's run-scoped HTTP server",
    "devices": {
      "hdd0": "blank-4g",
      "cdrom0": null
    },
    "boot": ["hdd0", "cdrom0"],
    "scripts": {
      "install": "openbsd-install"
    }
  },

  {
    // A named blank — the other way to write one. Name it when
    // something else refers to it; leave it inline and unnamed when
    // nothing does, as freedos.rlqb does.
    "type": "media",
    "name": "blank-4g",
    "materialize": "new",
    "size": "4G"
  },

  {
    "type": "media",
    "name": "openbsd-installer",
    "description": "The OpenBSD 7.9 amd64 install ISO",
    "materialize": "use",
    "read-only": true,
    "location": "https://cdn.openbsd.org/pub/OpenBSD/7.9/amd64/install79.iso",
    "sha256": "7a4a92e953618035097c796a90b54424a0f3ae775552e1e7d102cf8a5130449f"
  }
]
