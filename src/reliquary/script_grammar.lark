// SPDX-License-Identifier: GPL-3.0-only
//
// The typed grammar of the reliquary script language, mirroring the
// normative EBNF in planning/design/script-spec.md ("Core grammar").
//
// Tokens come from reliquary's own lexer (script_nodes.tokenize),
// adapted in script_parser.py, so every terminal here is %declare'd
// rather than given a pattern: lexical rules and their diagnostics
// belong to the lexer, not to this file.
//
// Division of labour: this grammar fixes node names and the type and
// arity of their POSITIONAL arguments. Modifiers are uniform here and
// checked against each node's signature in the transformer, which can
// name the node and list what it accepts. The V-numbered static rules
// (V3 and V7-V12 especially) stay above the grammar, where a
// diagnostic can cite its id -- encoding them here would trade named
// errors for "unexpected token". That is why bodies below are
// permissive: a phase takes statements and handlers in any mix (V9
// splits them), a branching wait takes one or more handlers (V8
// requires two), and a phase body need not terminate (V11).
//
// The body is one permissive unit list for the same reason. A `with`
// block wraps phases in a phased script and statements in a linear
// one, and which of those it is cannot be known at the `with` --
// only on reaching the first unit inside it, which is unbounded
// lookahead. So the two script shapes are no longer split here: the
// grammar admits any mix of phases, statements and scopes, and V10
// and V2 decide it above, where a diagnostic can say which shape the
// script is and what the block was allowed to hold.

script: header* property_def* http_def* body?

header: KW_DESCRIPTION STRING _NL       -> h_description
      | KW_PLATFORM NAME _NL            -> h_platform
      | KW_MACHINE NAME _NL             -> h_machine
      | KW_ENTRY NAME _NL               -> h_entry
      | KW_TIMEOUT DURATION _NL         -> h_timeout
      | KW_DEADLINE DURATION _NL        -> h_deadline
      | KW_PACING DURATION _NL          -> h_pacing
      // A proportion, not a duration: it lexes as a bare number,
      // which reaches the grammar as NAME.
      | KW_STABILITY NAME _NL           -> h_stability

property_def: KW_PROPERTY NAME NAME? modifier* _NL
http_def: KW_HTTP modifier* _open content_def+ _close
content_def: KW_CONTENT NAME STRING modifier* TRIPLE _NL CONTENT_TEXT _NL
           | KW_CONTENT NAME STRING modifier* _NL

body: unit+
?unit: phase | statement | scope_block

// A scoped machine-state change. The head verb is an ordinary NAME:
// keywords are recognized only where a node may start, so `insert`
// after `with` lexes as a word. Which three names are legal, and how
// many arguments each takes, is the transformer's -- it can name the
// head, where "unexpected token" could not.
scope_block: KW_WITH NAME scope_arg+ _open unit+ _close
?scope_arg: NAME | MEDIA_REF | PROP_REF

phase: KW_PHASE NAME modifier* _open phase_item+ _close
?phase_item: statement | handler

?statement: observation | action | transfer

observation: KW_WAIT condition? modifier* _NL           -> wait_one
           | KW_WAIT modifier* _open handler+ _close    -> wait_branching

// A handler's condition is optional here for the same reason a
// wait's is: it may arrive as a named channel (on machine=stopped),
// and V7 owns the count either way.
?handler: on_handler | always_handler
on_handler: KW_ON condition? modifier* _open statement+ _close
always_handler: KW_ALWAYS condition? modifier* _open statement+ _close

// A bare string or regex is the screen observation -- its only
// spelling. Every other channel arrives as a modifier (machine=),
// and V7 checks that exactly one condition is present. A bare word
// is admitted only so that V7 can say what is wrong with it (the
// superseded `wait stopped`): it names no channel and never
// validates.
condition: STRING                       -> screen_text
         | REGEX                        -> screen_regex
         | MEDIA_REF                    -> screen_landmark
         | NAME                         -> bare_condition

transfer: KW_GOTO NAME _NL              -> goto
        | KW_FINISH _NL                 -> finish

action: KW_ENTER STRING modifier* _NL                   -> enter
      | KW_TYPE STRING modifier* _NL                    -> type_text
      | KW_HTTP NAME NAME* modifier* _NL                -> http_control
      | KW_HTTP NAME NAME* modifier* _open content_def+ _close -> http_control
      | KW_PRESS NAME+ modifier* _NL                    -> press
      | KW_SELECT STRING modifier* _NL                  -> select
      | KW_SCREENSHOT NAME? modifier* _NL               -> screenshot
      | KW_INSERT NAME media_arg modifier* _NL          -> insert
      | KW_EJECT NAME modifier* _NL                     -> eject
      | KW_SET_BOOT NAME+ modifier* _NL                 -> set_boot
      | KW_SET NAME STRING modifier* _NL                -> set_var
      | KW_START modifier* _NL                          -> start
      | KW_STOP modifier* _NL                           -> stop
      | KW_FONT media_arg+ modifier* _NL                -> font_stmt

?media_arg: MEDIA_REF | PROP_REF

modifier: MOD_NAME mod_value
?mod_value: STRING | REGEX | DURATION | NAME | MEDIA_REF | PROP_REF

_open: _BLOCK_OPEN _NL
_close: _BLOCK_CLOSE _NL

%declare KW_DESCRIPTION KW_PLATFORM KW_MACHINE KW_ENTRY KW_TIMEOUT KW_PACING
%declare KW_STABILITY
%declare KW_DEADLINE KW_PROPERTY KW_HTTP KW_CONTENT KW_PHASE KW_WITH
%declare KW_WAIT KW_ON KW_ALWAYS
%declare KW_GOTO KW_FINISH KW_ENTER KW_TYPE KW_PRESS KW_SELECT
%declare KW_SCREENSHOT KW_INSERT KW_EJECT KW_SET_BOOT KW_SET KW_START KW_STOP
%declare KW_FONT
%declare NAME STRING REGEX DURATION MEDIA_REF PROP_REF MOD_NAME TRIPLE CONTENT_TEXT
%declare _NL _BLOCK_OPEN _BLOCK_CLOSE
